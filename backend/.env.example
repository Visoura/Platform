COMPOSE_PROJECT_NAME=visoura-platform

DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_FRAMES_RAW=frames.raw
KAFKA_TOPIC_FRAMES_PROCESSED=frames.processed
KAFKA_TOPIC_PARTITIONS=4

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_VECTOR_SIZE=384
TRACKING_MATCH_THRESHOLD=0.75

# The vision-pipeline AI service is external to this compose project - point
# this at wherever it's actually running (its own docker-compose, another
# host, etc). host.docker.internal works if it's running directly on this
# machine's host (Linux needs the extra_hosts mapping already set on the
# backend/gpu-consumer services in docker-compose.yml).
AI_SERVICE_URL=http://host.docker.internal:3000
AI_SERVICE_TIMEOUT=25

SESSION_MAX_CAMERAS=4
SESSION_START_DELAY_SECONDS=5
PRODUCER_TARGET_FPS=10
PRODUCER_BATCH_SIZE=4
PRODUCER_FRAME_WIDTH=640
PRODUCER_FRAME_HEIGHT=360
GPU_CONSUMER_BATCH_SIZE=8
GPU_CONSUMER_POLL_TIMEOUT=0.5
