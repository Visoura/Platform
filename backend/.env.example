COMPOSE_PROJECT_NAME=visoura-platform

DJANGO_SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_VECTOR_SIZE=384
TRACKING_MATCH_THRESHOLD=0.85

# The vision-pipeline AI service is external to this compose project - point
# this at wherever it's actually running (its own docker-compose, another
# host, etc). host.docker.internal works if it's running directly on this
# machine's host (Linux needs the extra_hosts mapping already set on the
# backend service in docker-compose.yml). Only used by preprocess_camera now -
# live sessions replay precomputed results and never call this service.
AI_SERVICE_URL=http://host.docker.internal:3000
AI_SERVICE_TIMEOUT=25

SESSION_MAX_CAMERAS=4

# Preprocessing: every frame of the source video is processed - no sampling,
# no duration cap. Source videos should already be trimmed to a reasonable
# length before preprocessing.
PREPROCESS_BATCH_SIZE=16
PREPROCESS_FRAME_WIDTH=640
PREPROCESS_FRAME_HEIGHT=360
